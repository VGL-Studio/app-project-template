<?xml version="1.0" encoding="utf-8"?>
<!-- English is the default language; values-vi holds Vietnamese. MissingTranslation is ignored for this whole file,
     because app_name has no Vietnamese entry and the attribute cannot go on its line: scripts/new-app.sh rewrites that
     exact line. Every other string here must still get its values-vi entry. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <string name="app_name">App Template</string>
    <string name="network_lost_title">No internet connection</string>
    <string name="network_lost_message">This app needs the Internet to work. Check Wi-Fi or mobile data, then try again.</string>
    <string name="network_lost_retry">Try again</string>
    <string name="network_lost_still_offline">Still no connection. Please try again in a moment.</string>
</resources>
